from pybricks.hubs import PrimeHub
from pybricks.pupdevices import ForceSensor
from pybricks.parameters import Port
from pybricks.messaging import BLERadio
from pybricks.tools import wait

hub = PrimeHub()

sensor = ForceSensor(Port.B)

radio = BLERadio(broadcast_channel=1)

print("LETICIA PRONTA")

ultimo = False

while True:

    pressionado = sensor.pressed()

    if pressionado and not ultimo:
        print("ON")
        radio.broadcast("ON")

    elif not pressionado and ultimo:
        print("OFF")
        radio.broadcast("OFF")

    ultimo = pressionado

    wait(50)
