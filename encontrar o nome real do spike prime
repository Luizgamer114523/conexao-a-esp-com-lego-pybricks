#include <BLEDevice.h>
#include <BLEScan.h>
#include <BLEAdvertisedDevice.h>

BLEScan *scan;

// =====================================================
// CALLBACK
// =====================================================

class Callback : public BLEAdvertisedDeviceCallbacks {

  void onResult(BLEAdvertisedDevice device) override {

    Serial.println();
    Serial.println("==============================");

    // NOME
    if (device.haveName()) {
      Serial.print("NOME: ");
      Serial.println(device.getName().c_str());
    } else {
      Serial.println("NOME: <sem nome>");
    }

    // ENDERECO
    Serial.print("ENDERECO: ");
    Serial.println(device.getAddress().toString().c_str());

    // RSSI
    Serial.print("RSSI: ");
    Serial.print(device.getRSSI());
    Serial.println(" dBm");

    // MANUFACTURER DATA
    if (device.haveManufacturerData()) {

      std::string data = device.getManufacturerData();

      Serial.print("HEX: ");

      for (int i = 0; i < data.length(); i++) {

        uint8_t b = (uint8_t)data[i];

        if (b < 16) {
          Serial.print("0");
        }

        Serial.print(b, HEX);
        Serial.print(" ");
      }

      Serial.println();

      Serial.print("TAMANHO: ");
      Serial.print(data.length());
      Serial.println(" bytes");

    } else {

      Serial.println("HEX: <sem manufacturer data>");
    }

    Serial.println("==============================");
  }
};


// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("=================================");
  Serial.println("      SCANNER BLE ESP32");
  Serial.println("=================================");
  Serial.println();

  BLEDevice::init("");

  scan = BLEDevice::getScan();

  scan->setAdvertisedDeviceCallbacks(
    new Callback(),
    true
  );

  scan->setActiveScan(true);

  scan->setInterval(100);
  scan->setWindow(99);

  Serial.println("Scanner iniciado!");
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  Serial.println();
  Serial.println(">>> PROCURANDO DISPOSITIVOS...");

  scan->start(5, false);

  scan->clearResults();

  delay(1000);
}
