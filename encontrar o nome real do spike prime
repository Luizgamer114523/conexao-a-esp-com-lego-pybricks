#include <BLEDevice.h>
#include <BLEScan.h>
#include <BLEAdvertisedDevice.h>

BLEScan *scan;

// ============================================================
// MOSTRA HEX
// ============================================================

void mostrarHex(String data) {

  Serial.print("MANUFACTURER DATA: ");

  for (int i = 0; i < data.length(); i++) {

    uint8_t b = (uint8_t)data[i];

    if (b < 0x10) {
      Serial.print("0");
    }

    Serial.print(b, HEX);
    Serial.print(" ");
  }

  Serial.println();
}


// ============================================================
// CALLBACK
// ============================================================

class Callback : public BLEAdvertisedDeviceCallbacks {

  void onResult(BLEAdvertisedDevice device) override {

    Serial.println();
    Serial.println("========================================");

    // NOME
    if (device.haveName()) {

      Serial.print("NOME: ");
      Serial.println(device.getName().c_str());

    } else {

      Serial.println("NOME: desconhecido");
    }

    // MAC
    Serial.print("MAC: ");
    Serial.println(device.getAddress().toString().c_str());

    // RSSI
    Serial.print("RSSI: ");
    Serial.println(device.getRSSI());

    // MANUFACTURER DATA
    if (device.haveManufacturerData()) {

      String data = device.getManufacturerData();

      mostrarHex(data);

      Serial.print("TAMANHO: ");
      Serial.print(data.length());
      Serial.println(" bytes");

      // ------------------------------------------------------
      // PROCURA PYBRICKS
      // ------------------------------------------------------

      if (data.length() >= 2) {

        if ((uint8_t)data[0] == 0x97 &&
            (uint8_t)data[1] == 0x03) {

          Serial.println();
          Serial.println("**************************************");
          Serial.println("***      PYBRICKS ENCONTRADO!      ***");
          Serial.println("**************************************");

          if (data.length() >= 3) {

            Serial.print("CANAL: ");
            Serial.println((uint8_t)data[2]);
          }
        }
      }

    } else {

      Serial.println("MANUFACTURER DATA: nenhum");
    }

    Serial.println("========================================");
  }
};


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("========================================");
  Serial.println("       ESP32 BLE SCANNER");
  Serial.println("       SPIKE / PYBRICKS");
  Serial.println("========================================");
  Serial.println();

  BLEDevice::init("ESP32_SCANNER");

  scan = BLEDevice::getScan();

  scan->setAdvertisedDeviceCallbacks(
    new Callback(),
    true
  );

  scan->setActiveScan(true);

  scan->setInterval(100);
  scan->setWindow(99);

  Serial.println("Scanner iniciado!");
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  Serial.println();
  Serial.println(">>> ESCANEANDO...");

  scan->start(3, false);

  scan->clearResults();

  delay(300);
}
